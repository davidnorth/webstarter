    <div><span style="font-size: var(--text-3xl); font-weight: 700; line-height: 1.1;">--text-3xl</span> <code style="font-size: var(--text-xs);">clamp(2.25rem, 1.9rem + 1.75vw, 3rem)</code></div>
    <div><span style="font-size: var(--text-2xl); font-weight: 700; line-height: 1.1;">--text-2xl</span> <code style="font-size: var(--text-xs);">clamp(1.75rem, 1.5rem + 1.25vw, 2.25rem)</code></div>
    <div><span style="font-size: var(--text-xl); font-weight: 700;">--text-xl</span> <code style="font-size: var(--text-xs);">clamp(1.375rem, 1.2rem + 0.875vw, 1.75rem)</code></div>
    <div><span style="font-size: var(--text-lg);">--text-lg</span> <code style="font-size: var(--text-xs);">clamp(1.125rem, 1rem + 0.625vw, 1.375rem)</code></div>
