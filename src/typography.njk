    <div><span style="font-size: var(--text-sm);">--text-sm</span> <code style="font-size: var(--text-xs);">clamp(0.875rem, 0.8rem + 0.375vw, 1rem)</code></div>
    <div><span style="font-size: var(--text-xs);">--text-xs</span> <code style="font-size: var(--text-xs);">clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem)</code></div>
  </div>

