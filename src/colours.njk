  <h2>Semantic tokens</h2>
  <div class="stack">
    <div class="swatch-row"><div class="swatch-sm" style="background: var(--color-text);"></div><code>--color-text</code> — neutral-900</div>
    <div class="swatch-row"><div class="swatch-sm" style="background: var(--color-text-muted);"></div><code>--color-text-muted</code> — neutral-600</div>
    <div class="swatch-row"><div class="swatch-sm" style="background: var(--color-surface); border: 1px solid var(--color-border);"></div><code>--color-surface</code> — white</div>
    <div class="swatch-row"><div class="swatch-sm" style="background: var(--color-surface-raised); border: 1px solid var(--color-border);"></div><code>--color-surface-raised</code> — neutral-50</div>
